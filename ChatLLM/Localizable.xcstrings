    "Automatically remove conversations older than the selected period. Deleted chats cannot be recovered." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht Chats automatisch, wenn sie älter als der gewählte Zeitraum sind. Gelöschte Chats können nicht wiederhergestellt werden."
          }
