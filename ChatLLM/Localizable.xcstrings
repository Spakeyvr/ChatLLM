    "Add a Tavily API key if you want the assistant to search the web for current information." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge einen Tavily-API-Schlüssel hinzu, damit der Assistent im Web nach aktuellen Informationen suchen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a Tavily API key if you want the assistant to search the web for current information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una clave de API de Tavily para que el asistente busque información actual en la web."
          }
        }
      }
    },
    "Add an action beneath assistant messages to view raw output and generation diagnostics." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt unter Antworten eine Aktion für die Rohausgabe und Generierungsdiagnose an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add an action beneath assistant messages to view raw output and generation diagnostics."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una acción debajo de las respuestas para ver la salida sin procesar y los diagnósticos de generación."
          }
        }
      }
    },
