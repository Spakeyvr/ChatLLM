    "All conversations and their attachments will be permanently deleted. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Chats und ihre Anhänge werden dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All conversations and their attachments will be permanently deleted. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán permanentemente todos los chats y sus archivos adjuntos. Esta acción no se puede deshacer."
          }
        }
      }
    },
    "All conversations except the current one will be permanently deleted. If no chat is selected, the most recent chat is kept. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Chats außer dem aktuellen werden dauerhaft gelöscht. Ist kein Chat ausgewählt, bleibt der neueste erhalten. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All conversations except the current one will be permanently deleted. If no chat is selected, the most recent chat is kept. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán permanentemente todos los chats excepto el actual. Si no hay ningún chat seleccionado, se conservará el más reciente. Esta acción no se puede deshacer."
          }
        }
      }
    },
    "Allow models and tool calls that exceed this device’s memory limits. This can cause crashes or severe slowdowns." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt Modelle und Tool-Aufrufe, die das Speicherlimit dieses Geräts überschreiten. Dies kann zu Abstürzen oder starken Verzögerungen führen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow models and tool calls that exceed this device’s memory limits. This can cause crashes or severe slowdowns."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite modelos y llamadas a herramientas que superen los límites de memoria del dispositivo. Puede provocar cierres inesperados o una gran lentitud."
          }
        }
      }
    },
