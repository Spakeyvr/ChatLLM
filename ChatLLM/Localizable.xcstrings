    "ChatLLM" : {
      "shouldTranslate" : false
    },
    "ChatLLM couldn't open your saved chats. New messages in this session won't be saved. Keep your existing chats to try again on the next launch, or start fresh with an empty history. A backup copy has been kept either way." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatLLM konnte deine gespeicherten Chats nicht öffnen. Neue Nachrichten in dieser Sitzung werden nicht gespeichert. Behalte deine vorhandenen Chats, um es beim nächsten Start erneut zu versuchen, oder beginne neu mit einem leeren Verlauf. In beiden Fällen wurde eine Sicherungskopie aufbewahrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatLLM couldn't open your saved chats. New messages in this session won't be saved. Keep your existing chats to try again on the next launch, or start fresh with an empty history. A backup copy has been kept either way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatLLM no pudo abrir tus chats guardados. Los mensajes nuevos de esta sesión no se guardarán. Conserva tus chats existentes para volver a intentarlo en el próximo inicio, o empieza de cero con un historial vacío. En ambos casos se ha guardado una copia de seguridad."
          }
        }
      }
    },
    "ChatLLM is in beta. Features may change, and you may encounter bugs. Your feedback helps improve the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatLLM ist in der Beta-Phase. Funktionen können sich ändern und Fehler auftreten. Dein Feedback hilft, die App zu verbessern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatLLM is in beta. Features may change, and you may encounter bugs. Your feedback helps improve the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChatLLM está en fase beta. Las funciones pueden cambiar y puede haber errores. Tus comentarios ayudan a mejorar la app."
          }
        }
      }
    },
