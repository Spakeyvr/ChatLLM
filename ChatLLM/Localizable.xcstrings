    "Adjusts user and assistant messages. Settings and other controls follow your device’s text size." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt die Textgröße der Nachrichten an. Einstellungen und andere Bedienelemente verwenden die Textgröße deines Geräts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjusts user and assistant messages. Settings and other controls follow your device’s text size."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta los mensajes del usuario y del asistente. Los ajustes y otros controles usan el tamaño de texto del dispositivo."
          }
        }
      }
    },
    "Advanced" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erweitert"
