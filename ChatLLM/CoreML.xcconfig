//
//  CoreML.xcconfig
//  ChatLLM
//
//  CoreML build configuration to fix code generation warnings
//  Created: November 4, 2025
//

// MARK: - CoreML Code Generation

// Explicitly set Swift as the code generation language for CoreML models
// This fixes the warning about Markdown being detected as predominant language
COREML_CODEGEN_LANGUAGE = Swift

// Ensure Swift 6 language mode for CoreML generated code
SWIFT_VERSION = 6.0

// MARK: - Model Optimization

// Use all compute units (Neural Engine, GPU, CPU) for optimal performance
COREML_CODEGEN_DEPLOYMENT_TARGET = iOS18.0

// MARK: - Additional Build Settings

// Ensure CoreML models are properly included in the bundle
ASSETCATALOG_COMPILER_GENERATE_ASSET_SYMBOLS = YES
